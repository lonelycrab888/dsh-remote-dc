{
  "name": "dsh-remote-dc",
  "version": "0.1.1",
  "description": "An unofficial community integration for Desktop Commander in DeepSeek Harness.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",
    "./client": "./src/client.cjs",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale",
    "src",
    "examples",
    "README.en.md",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "title": "Remote DC for dsh"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-mcp-client": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test scripts/*.test.js",
    "test:dsh": "node scripts/smoke.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lonelycrab888/dsh-remote-dc.git"
  },
  "homepage": "https://github.com/lonelycrab888/dsh-remote-dc#readme",
  "bugs": {
    "url": "https://github.com/lonelycrab888/dsh-remote-dc/issues"
  }
}
